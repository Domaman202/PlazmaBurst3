{
    "author": "Eric Gurt <eric-gurt@noreply>",
    "name": "Plazma-Burst-3",
    "version": "0.0.26",
    "description": "Plazma Burst 3 browser game wrapper with additional features",
    "main": "electron-main.js",
    "scripts": {
        "start": "electron --inspect=9230 . --enable-logging",
        "startlocal": "electron --PB3_FORCE_LOCALHOST --inspect=9230 . --enable-logging",
        "build": "electron-builder --win --linux --x64",
        "release": "electron-builder --win --linux --x64 --publish always"
    },
    "dependencies": {
        "electron-updater": "^6.6.2",
        "ws": "^8.14.2"
    },
    "devDependencies": {
        "electron": "39.2.7",
        "electron-builder": "^24.13.3"
    },
    "build": {
        "appId": "com.ericgurt.plazmaburst3",
        "productName": "Plazma Burst 3",
        "electronVersion": "39.2.7",
        "directories": {
            "buildResources": "build"
        },
        "files": [
            "electron-main.js",
            "preload.js",
            "node_modules/ws/**/*"
        ],
        "asarUnpack": [
            "node_modules/ws/**/*"
        ],
        "extraMetadata": {
            "main": "electron-main.js"
        },
        "publish": {
            "provider": "github",
            "owner": "Eric-Gurt",
            "repo": "PlazmaBurst3",
            "releaseType": "release"
        },
        "win": {
            "target": [
                "nsis",
                "portable"
            ],
            "publisherName": "Eric Gurt",
            "artifactName": "Plazma Burst 3.${ext}",
            "verifyUpdateCodeSignature": false
        },
        "nsis": {
            "artifactName": "Plazma Burst 3 setup.exe",
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "runAfterFinish": true,
            "allowElevation": true,
            "perMachine": false
        },
        "portable": {
            "artifactName": "Plazma Burst 3.exe"
        },
        "linux": {
            "target": [
                "AppImage",
                "deb"
            ],
            "category": "Game",
            "artifactName": "Plazma Burst 3.${ext}"
        }
    }
}
